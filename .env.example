# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# MapTiler & MapLibre Configuration
MAPTILER_API_KEY=your_maptiler_api_key
MAPTILER_STYLE_URL=https://api.maptiler.com/maps/your-style-id/style.json?key=your_maptiler_api_key

# Brevo Transactional Notification API
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@your-verified-domain.com
BREVO_SENDER_NAME=TKA Rail Tracking

# Application Defaults (WIB | WITA | WIT)
DEFAULT_TIMEZONE=WIB

