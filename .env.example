# Salin file ini menjadi `.env` (khusus lokal/server, JANGAN di-commit ke Git)
API_GATEWAY_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Backend Supabase Credentials (Disembunyikan di Secure API Gateway)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Brevo Transactional Email (Server-side Only)
BREVO_API_KEY=your-brevo-api-key
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=TKA Rail Tracking

# MapTiler
MAPTILER_API_KEY=your-maptiler-key
MAPTILER_STYLE_URL=https://api.maptiler.com/maps/streets/style.json?key=your-maptiler-key

DEFAULT_TIMEZONE=WIB
